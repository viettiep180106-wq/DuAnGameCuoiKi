  - ID: SC_26
    Category: "Ho\u1EA1t \u0111\u1ED9ng Nh\xE1nh"
    Context: "Ho\u1EA1t \u0111\u1ED9ng 1.3: M\u1EDF r\u01B0\u01A1ng b\xED \u1EA9n"
