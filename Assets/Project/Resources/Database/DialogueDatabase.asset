  m_Name: DialogueDatabase
  m_EditorClassIdentifier: Assembly-CSharp::DialogueDatabaseSO
  entries:
  - ID: SC_01
    Category: "M\u1EDF \u0111\u1EA7u Wave (Pre-Wave)"
    Context: "1. Di chuy\u1EC3n sang Wave m\u1EDBi (Bay 3 gi\xE2y)"
    Speaker: "Ph\xE1p S\u01B0"
    Text: "B\u1EADt ch\u1EBF \u0111\u1ED9 l\u01B0\u1EDBt gi\xF3 l\u1EB9 l\xE0ng n\xE0o!
      \u0110ang bay m\xE0 gi\xF3 t\xE1p v\xE0o m\u1EB7t m\xE1t r\u01B0\u1EE3i, ti\u1EBFn
      sang wave ti\u1EBFp theo th\xF4i!"
    AnimationNote: "Bay l\u01B0\u1EE3n chibi, \xE1o cho\xE0ng tung bay, thanh ti\u1EBFn
      tr\xECnh l\u1EA5p \u0111\u1EA7y t\u1EEB 0 -> 1 b\xE1m theo icon nh\xE2n v\u1EADt."
    IsPlayer: 1
  - ID: SC_02
    Category: "M\u1EDF \u0111\u1EA7u Wave (Pre-Wave)"
    Context: "1. Di chuy\u1EC3n sang Wave m\u1EDBi (Bay 3 gi\xE2y)"
    Speaker: "Th\xE1nh V\u1EADt"
    Text: "\u0110\u1ECBnh v\u1ECB radar \u0111ang qu\xE9t khu v\u1EF1c ph\xEDa tr\u01B0\u1EDBc!
      3 gi\xE2y t\u1ED1c bi\u1EBFn, gi\u1EEF ch\u1EB7t m\u0169 bay k\u1EBBo r\u1EDBt
      k\xECa b\u1EA1n \xEAi!"
    AnimationNote: "Xoay tr\xF2n ph\xE1t s\xE1ng neon, hi\u1EC7n icon m\u0169i t\xEAn
      ti\u1EBFn l\xEAn d\u1EABn \u0111\u01B0\u1EDDng, n\u1EC1n cu\u1ED9n ng\u01B0\u1EE3c
      3.0s."
    IsPlayer: 0
  - ID: SC_03
    Category: "M\u1EDF \u0111\u1EA7u Trong Wave"
    Context: "2. Banner Wave Kh\xE1m Ph\xE1 xu\u1EA5t hi\u1EC7n"
    Speaker: "Th\xE1nh V\u1EADt"
    Text: "Ting ting! Radar b\xE1o ph\xEDa tr\u01B0\u1EDBc ho\xE0n to\xE0n y\xEAn
      \u1EA3, ch\u1EC9 n\u1ED3ng n\u1EB7c m\xF9i th\u01A1m c\u1EE7a c\u01A1 h\u1ED9i
      th\xF4i! M\u1ED9t kh\xF4ng gian b\xED \u1EA9n \u0111ang v\u1EABy g\u1ECDi!"
    AnimationNote: "Chi\u1EBFu \u0111\xE8n neon l\u1EA5p l\xE1nh, hi\u1EC7n bi\u1EC3u
      t\u01B0\u1EE3ng x\xFAc x\u1EAFc v\xE0 r\u01B0\u01A1ng b\xE1u, m\u1EDF l\u1ED1i
      v\xE0o khu v\u1EF1c may r\u1EE7i."
    IsPlayer: 0
  - ID: SC_04
    Category: "M\u1EDF \u0111\u1EA7u Trong Wave"
    Context: "2. Banner Wave Kh\xE1m Ph\xE1 xu\u1EA5t hi\u1EC7n"
    Speaker: "Ph\xE1p S\u01B0"
    Text: "\u1ED2 h\u1ED1! Tr\xFAng qu\u1EA3 wave th\u01B0 gi\xE3n r\u1ED3i! \u0110\u1EC3
      tr\u1EABm v\xE0o th\xE1m hi\u1EC3m xem c\xF3 m\xF3n b\u1EA3o v\u1EADt hay th\u1EA7n
      may m\u1EAFn n\xE0o \u0111\u1ED9 kh\xF4ng n\xE0o!"
    AnimationNote: "H\u0103m h\u1EDF xoa hai b\xE0n tay, hai m\u1EAFt s\xE1ng h\xECnh
      ng\xF4i sao, l\u01B0\u1EDBt v\xE0o khu v\u1EF1c s\u1EF1 ki\u1EC7n kh\xE1m ph\xE1."
    IsPlayer: 1
  - ID: SC_05
    Category: "S\u1EF1 ki\u1EC7n Nh\xE1nh"
    Context: "2. Nh\xE1nh 1: Ph\xE1t hi\u1EC7n Phi\u1EBFn \u0111\xE1 c\u1ED5"
    Speaker: "Ph\xE1p S\u01B0"
    Text: "Ui da! C\xE1i g\xEC c\u1EA5n ch\xE2n tr\u1EABm th\u1EBF n\xE0y?! \u1ED0i
      d\u1ED3i \xF4i, m\u1ED9t phi\u1EBFn \u0111\xE1 rune c\u1ED5 ph\xE1t s\xE1ng
      l\u1EADp l\xF2e d\u01B0\u1EDBi \u0111\u1ED1ng r\xEAu!"
    AnimationNote: "V\u1EA5p ch\xE2n t\xE9 d\xFAi d\u1EE5i, \xF4m ng\xF3n ch\xE2n
      xu\xFDt xoa r\u1ED3i tr\u1ED1 m\u1EAFt kinh ng\u1EA1c ch\u1EC9 tay v\xE0o phi\u1EBFn
      \u0111\xE1."
    IsPlayer: 1
  - ID: SC_06
    Category: "S\u1EF1 ki\u1EC7n Nh\xE1nh"
    Context: "2. Nh\xE1nh 1: Ph\xE1t hi\u1EC7n Phi\u1EBFn \u0111\xE1 c\u1ED5"
    Speaker: "Th\xE1nh V\u1EADt"
    Text: "\xDAi ch\xE0, m\xF9 m\u1EDD th\u1EBF m\xE0 v\u1EDB \u0111\u01B0\u1EE3c
      kho b\xE1u c\u1ED5 \u0111\u1EA1i! Nh\u01B0ng khoan... d\xF2ng ch\u1EEF rune
      \u0111\xF2i 25 l\xF5i n\u0103ng l\u01B0\u1EE3ng \u0111\u1EC3 k\xEDch ho\u1EA1t
      k\xECa!"
    AnimationNote: "Ph\xF3ng to thu nh\u1ECF h\xE0o quang t\xEDm huy\u1EC1n b\xED,
      qu\xE9t lu\u1ED3ng s\xE1ng laser soi v\xE0o d\xF2ng c\u1ED5 ng\u1EEF kh\u1EAFc
      tr\xEAn \u0111\xE1."
    IsPlayer: 0
  - ID: SC_07
    Category: "S\u1EF1 ki\u1EC7n Nh\xE1nh"
    Context: "2. Nh\xE1nh 1: Ph\xE1t hi\u1EC7n Phi\u1EBFn \u0111\xE1 c\u1ED5"
    Speaker: "Ph\xE1p S\u01B0"
    Text: "C\xE1i g\xEC?! \u0110\xE3 n\xFAp trong hang s\xE2u t\u0103m t\u1ED1i m\xE0
      c\xF2n g\u1EB7p ma ph\xE1p t\u01B0 b\u1EA3n thu ph\xED c\u1EA7u \u0111\u01B0\u1EDDng
      \xE0?! \u0110\xFAng l\xE0 c\u1EA1n l\u1EDDi!"
    AnimationNote: "\xD4m \u0111\u1EA7u tr\u1EE3n tr\xF2n m\u1EAFt h\xE9t toang,
      tay vung v\u1EA9y ch\u1EC9 v\xE0o khe nh\xE9t \u0111\xE1 rune b\u1EF1c t\u1EE9c."
    IsPlayer: 1
  - ID: SC_08
    Category: "S\u1EF1 ki\u1EC7n Nh\xE1nh"
    Context: "2. Nh\xE1nh 1: Ph\xE1t hi\u1EC7n Phi\u1EBFn \u0111\xE1 c\u1ED5"
    Speaker: "Th\xE1nh V\u1EADt"
    Text: "Th\u1EDDi bu\u1ED5i n\xE0y l\xE0m g\xEC c\xF3 b\u1EEFa tr\u01B0a mi\u1EC5n
      ph\xED! C\xF3 25 l\xF5i th\xF4i m\xE0, n\u1EA1p n\u0103ng l\u01B0\u1EE3ng \u0111i
      \u0111\u1EC3 k\xEDch ho\u1EA1t c\u01A1 quan c\u1ED5 ng\u1EEF!"
    AnimationNote: "Nh\u1EA5p nh\xE1y \u0111\xE8n neon li\xEAn h\u1ED3i, gi\u01A1
      icon t\xFAi ti\u1EC1n l\u1EA5p l\xE1nh m\u1EDDi g\u1ECDi nhi\u1EC7t t\xECnh."
    IsPlayer: 0
  - ID: SC_09
    Category: "Ho\u1EA1t \u0111\u1ED9ng Nh\xE1nh"
    Context: "Ho\u1EA1t \u0111\u1ED9ng 1.1: Gacha (V\xF2ng quay)"
    Speaker: "Th\xE1nh V\u1EADt"
    Text: "Tada! B\xE0n xoay ma thu\u1EADt 6 \xF4 hi\u1EC7n h\xECnh: 3 Buff 3 Debuff
      \u0111an xen \u0111\u1ECBnh m\u1EC7nh! Quay m\u1ED9t v\xF2ng \u0111\u1ED5i
      \u0111\u1EDDi \u0111i b\u1EA1n \xEAi!"
    AnimationNote: "H\xF3a th\xE2n th\xE0nh kim quay v\xF2ng xoay ma thu\u1EADt neon
      l\u1EA5p l\xE1nh, ti\u1EBFng nh\u1EA1c x\u1ED5 s\u1ED1 't\xE8 te te' x\u1EADp
      x\xECnh."
    IsPlayer: 0
  - ID: SC_10
    Category: "Ho\u1EA1t \u0111\u1ED9ng Nh\xE1nh"
    Context: "Ho\u1EA1t \u0111\u1ED9ng 1.1: Gacha (V\xF2ng quay)"
    Speaker: "Ph\xE1p S\u01B0"
    Text: "Nh\xECn c\xE1i t\u1EC9 l\u1EC7 50/50 n\xE0y m\xE0 tim \u0111\u1EADp ch\xE2n
      run! Xin ch\u01B0 v\u1ECB th\u1EA7n linh ph\xF9 h\u1ED9 \u0111\u1ED9 tr\xEC,
      quay tr\xFAng \xF4 v\xE0ng ch\xF3i l\u1ECDi gi\xF9m con!"
    AnimationNote: "Hai tay n\u1EAFm ch\u1EB7t c\u1EA7n g\u1EA1t c\u1ED5 ng\u1EEF
      k\xE9o m\u1EA1nh h\u1EBFt s\u1EE9c, m\u1EAFt nh\u1EAFm t\u1ECBt l\u1EA9m b\u1EA9m
      c\u1EA7u kh\u1EA5n."
    IsPlayer: 1
  - ID: SC_11
    Category: "Ho\u1EA1t \u0111\u1ED9ng Nh\xE1nh"
    Context: "Ho\u1EA1t \u0111\u1ED9ng 1.1: Gacha (V\xF2ng quay)"
    Speaker: "Th\xE1nh V\u1EADt"
    Text: "Keng keng keng! N\u1ED5 h\u0169 c\u1EF1c ph\u1EA9m! B\xE0n xoay d\u1EEBng
      \u0111\xFAng \xF4 kim c\u01B0\u01A1ng: nh\u1EADn ngay hi\u1EC7u \u1EE9ng [N\u1ED9i
      dung Buff]!"
    AnimationNote: "B\u1EAFn ph\xE1o hoa ma thu\u1EADt t\u01B0ng b\u1EEBng, nh\u1EA1c
      chu\xF4ng chi\u1EBFn th\u1EAFng vang d\u1ED9i, h\xE0o quang v\xE0ng kim bao
      ph\u1EE7 Ph\xE1p S\u01B0."
    IsPlayer: 0
  - ID: SC_12
    Category: "Ho\u1EA1t \u0111\u1ED9ng Nh\xE1nh"
    Context: "Ho\u1EA1t \u0111\u1ED9ng 1.1: Gacha (V\xF2ng quay)"
    Speaker: "Ph\xE1p S\u01B0"
    Text: "\u1ED0i d\u1ED3i \xF4i uy t\xEDn lu\xF4n! \u0110\xE3 b\u1EA3o tay n\xE0y
      v\xE0ng r\xF2ng m\xE0! C\xF3 qu\u1EA3 buff n\xE0y th\xEC qu\xE1i wave sau c\u1EE9
      chu\u1EA9n b\u1ECB qu\u1EF3 r\u1EA1p d\u01B0\u1EDBi ch\xE2n tr\u1EABm!"
    AnimationNote: "Nh\u1EA3y c\u1EABng l\xEAn h\xF2 reo sung s\u01B0\u1EDBng, hai
      m\u1EAFt bi\u1EBFn th\xE0nh h\xECnh ng\xF4i sao l\u1EA5p l\xE1nh, chibi t\u1EA1o
      d\xE1ng si\xEAu ng\u1EA7u."
    IsPlayer: 1
  - ID: SC_13
    Category: "Ho\u1EA1t \u0111\u1ED9ng Nh\xE1nh"
    Context: "Ho\u1EA1t \u0111\u1ED9ng 1.1: Gacha (V\xF2ng quay)"
    Speaker: "Th\xE1nh V\u1EADt"
    Text: "T\xE8n ten... M\u0169i t\xEAn l\u1EC7ch sang \xF4 t\u1EED th\u1EA7n r\u1ED3i!
      Chia bu\u1ED3n c\xF9ng th\xED sinh, \xF4m tr\u1ECDn hi\u1EC7u \u1EE9ng th\u1ED1n:
      [N\u1ED9i dung Debuff]!"
    AnimationNote: "To\xE0n th\xE2n chuy\u1EC3n m\xE0u t\xEDm \u0111en \u1EA3m \u0111\u1EA1m,
      r\u01A1i icon \u0111\u1EA7u l\xE2u x\u01B0\u01A1ng ch\xE9o, n\u1ED1t nh\u1EA1c
      r\xE8 r\xE8 m\xE9o x\u1EB9o."
    IsPlayer: 0
  - ID: SC_14
    Category: "Ho\u1EA1t \u0111\u1ED9ng Nh\xE1nh"
    Context: "Ho\u1EA1t \u0111\u1ED9ng 1.1: Gacha (V\xF2ng quay)"
    Speaker: "Ph\xE1p S\u01B0"
    Text: "\u1EE6a alo?! Th\xE1nh V\u1EADt gian l\u1EADn c\xE0i b\u1EABy \u0111\xFAng
      kh\xF4ng?! D\xEDnh qu\u1EA3 debuff n\xE0y th\xEC g\xE1nh c\xF2ng c\u1EA3 l\u01B0ng,
      \u0111\xFAng l\xE0 ki\u1EBFp n\u1EA1n th\u1EE9 82!"
    AnimationNote: "Ng\xE3 ng\u1EEDa ra s\xE0n hang \xF4m \u0111\u1EA7u than kh\xF3c,
      m\u1EB7t m\xE0y t\xE1i m\xE9t, linh h\u1ED3n chibi bay l\u01A1 l\u1EEDng kh\u1ECFi
      m\u1ED3m."
    IsPlayer: 1
  - ID: SC_15
    Category: "Ho\u1EA1t \u0111\u1ED9ng Nh\xE1nh"
    Context: "Ho\u1EA1t \u0111\u1ED9ng 1.2: Roll (L\u1EADt th\u1EBB / \u0110\u1ED5
      x\xFAc x\u1EAFc)"
    Speaker: "Th\xE1nh V\u1EADt"
    Text: "Ch\xE0o m\u1EEBng \u0111\u1EBFn s\xF2ng b\xE0i c\u1ED5 ng\u1EEF! 3 th\u1EBB
      b\xE0i ma ph\xE1p b\xED \u1EA9n \u0111ang \xFAp tr\xEAn b\xE0n, l\u1EA7n roll
      \u0111\u1EA7u ti\xEAn ho\xE0n to\xE0n 'free' nh\xE9!"
    AnimationNote: "Bi\u1EBFn ra 3 l\xE1 b\xE0i ma thu\u1EADt l\u01A1 l\u1EEDng xoay
      v\xF2ng tr\xF2n, x\xF2e b\xE0i \u0111i\u1EC7u ngh\u1EC7 nh\u01B0 \u1EA3o thu\u1EADt
      gia Las Vegas."
    IsPlayer: 0
  - ID: SC_16
    Category: "Ho\u1EA1t \u0111\u1ED9ng Nh\xE1nh"
    Context: "Ho\u1EA1t \u0111\u1ED9ng 1.2: Roll (L\u1EADt th\u1EBB / \u0110\u1ED5
      x\xFAc x\u1EAFc)"
    Speaker: "Ph\xE1p S\u01B0"
    Text: "\u0110\u1EC3 tr\u1EABm th\u1EA9m \u0111\u1ECBnh nh\xE2n ph\u1EA9m xem
      n\xE0o! N\u1EBFu b\xE0i ph\xE8n th\xEC b\u1ECF th\xEAm 5 l\xF5i \u0111\u1ED5i
      l\u01B0\u1EE3t, quy\u1EBFt s\u0103n b\u1EB1ng \u0111\u01B0\u1EE3c buff Hi\u1EBFm!"
    AnimationNote: "Xoa c\u1EB1m \u0111\u0103m chi\xEAu suy ngh\u0129, ng\xF3n tay
      ch\u1EC9 tr\u1ECF qua l\u1EA1i gi\u1EEFa c\xE1c l\xE1 b\xE0i ma ph\xE1p r\u1EF1c
      s\xE1ng."
    IsPlayer: 1
  - ID: SC_17
    Category: "Ho\u1EA1t \u0111\u1ED9ng Nh\xE1nh"
    Context: "Ho\u1EA1t \u0111\u1ED9ng 1.2: Roll (L\u1EADt th\u1EBB / \u0110\u1ED5
      x\xFAc x\u1EAFc)"
    Speaker: "Th\xE1nh V\u1EADt"
    Text: "L\u1EADt b\xE0i th\u1EA7n th\xE1nh! Ra ngay th\u1EBB b\xE0i SSR l\u1EA5p
      l\xE1nh h\xE0o quang: b\u1EA1n nh\u1EADn \u0111\u01B0\u1EE3c hi\u1EC7u \u1EE9ng
      [N\u1ED9i dung Buff]!"
    AnimationNote: "Th\u1EBB b\xE0i b\u1ED1c ch\xE1y \xE1nh s\xE1ng ho\xE0ng kim
      r\u1EF1c r\u1EE1, Th\xE1nh V\u1EADt v\u1ED7 tay t\xE1n th\u01B0\u1EDFng reo
      h\xF2 ph\u1EA5n kh\xEDch."
    IsPlayer: 0
  - ID: SC_18
    Category: "Ho\u1EA1t \u0111\u1ED9ng Nh\xE1nh"
    Context: "Ho\u1EA1t \u0111\u1ED9ng 1.2: Roll (L\u1EADt th\u1EBB / \u0110\u1ED5
      x\xFAc x\u1EAFc)"
    Speaker: "Ph\xE1p S\u01B0"
    Text: "Haha \u0111\xFAng l\xE0 tay th\u01A1m c\xF3 s\u1ED1! Th\u1EBB x\u1ECBn
      th\u1EBF n\xE0y kh\xF4ng g\xE1nh team th\xEC h\u01A1i ph\xED, wave sau qu\xE1i
      ch\u1EC9 c\xF3 n\u01B0\u1EDBc kh\xF3c th\xE9t!"
    AnimationNote: "Gi\u01A1 cao th\u1EBB b\xE0i khoe khoang, ng\u1EEDa m\u1EB7t
      l\xEAn tr\u1EDDi c\u01B0\u1EDDi ha h\u1EA3 ki\u1EC3u \u0111\u1EAFc th\u1EAFng."
    IsPlayer: 1
  - ID: SC_19
    Category: "Ho\u1EA1t \u0111\u1ED9ng Nh\xE1nh"
    Context: "Ho\u1EA1t \u0111\u1ED9ng 1.2: Roll (L\u1EADt th\u1EBB / \u0110\u1ED5
      x\xFAc x\u1EAFc)"
    Speaker: "Th\xE1nh V\u1EADt"
    Text: "\u1ED0i d\u1ED3i \xF4i b\xE0i r\xE1c d\xEDnh b\u1EABy r\u1ED3i! R\xFAt
      nh\u1EA7m th\u1EBB Nguy\u1EC1n R\u1EE7a c\u1ED5 \u0111\u1EA1i, k\xEDch ho\u1EA1t
      hi\u1EC7u \u1EE9ng: [N\u1ED9i dung Debuff]!"
    AnimationNote: "Th\u1EBB b\xE0i x\xEC kh\xF3i \u0111en k\u1ECBt, bi\u1EBFn h\xECnh
      th\xE0nh icon m\u1EB7t h\u1EC1 trollface toe to\xE9t c\u01B0\u1EDDi c\u1EE3t."
    IsPlayer: 0
  - ID: SC_20
    Category: "Ho\u1EA1t \u0111\u1ED9ng Nh\xE1nh"
    Context: "Ho\u1EA1t \u0111\u1ED9ng 1.2: Roll (L\u1EADt th\u1EBB / \u0110\u1ED5
      x\xFAc x\u1EAFc)"
    Speaker: "Ph\xE1p S\u01B0"
    Text: "Tr\u1EDDi \u01A1i \u0111\u1EA5t h\u1EE1i! T\u01B0\u1EDFng b\u1EDB \u0111\u01B0\u1EE3c
      buff hi\u1EBFm ai d\xE8 b\u1ED1c tr\xFAng c\u1EE5c n\u1EE3! L\u1EA1i c\xF2n
      m\u1EA5t th\xEAm l\xF5i n\u0103ng l\u01B0\u1EE3ng n\u1EEFa, cay x\xE9 l\xF2ng!"
    AnimationNote: "N\xE9m th\u1EBB b\xE0i xu\u1ED1ng \u0111\u1EA5t gi\u1EADm ch\xE2n
      b\xECnh b\u1ECBch, hai m\xE1 ph\u1ED3ng l\xEAn t\u1EE9c t\u1ED1i ph\u1EE5ng
      ph\u1ECBu."
    IsPlayer: 1
  - ID: SC_21
    Category: "Ho\u1EA1t \u0111\u1ED9ng Nh\xE1nh"
    Context: "Ho\u1EA1t \u0111\u1ED9ng 1.3: M\u1EDF r\u01B0\u01A1ng b\xED \u1EA9n"
    Speaker: "Th\xE1nh V\u1EADt"
    Text: "M\u1ED9t chi\u1EBFc r\u01B0\u01A1ng \u0111\xE1 phong \u1EA5n k\xE8m m\u1ED9t
      m\u1EA3nh gi\u1EA5y t\xE2m s\u1EF1 b\xED \u1EA9n! B\xEAn trong c\xF3 hai phong
      th\u01B0: 1 ph\xFAc l\xE0nh v\xE0 1 tai h\u1ECDa \u0111\u1EA5y!"
    AnimationNote: "Chi\u1EBFu lu\u1ED3ng s\xE1ng v\xE0o chi\u1EBFc r\u01B0\u01A1ng
      c\u1ED5 b\u1EB1ng \u0111\xE1 b\xE1m \u0111\u1EA7y r\xEAu phong, ch\u1EC9 v\xE0o
      b\u1EE9c th\u01B0 ni\xEAm phong s\xE1p \u0111\u1ECF."
    IsPlayer: 0
  - ID: SC_22
    Category: "Ho\u1EA1t \u0111\u1ED9ng Nh\xE1nh"
